@code {
    private int _activeTab = 0;
    private int _currentPage = 1;
    private const int PageSize = 8;

    private List<GameCardModel> _allCards = new();
    private List<GameCardModel> _filteredCards = new();
    private GameCardModel? _selectedCard;

    private bool _showGlossaryModal = false;
    private bool _showTermModal = false;
    private TechnicalTermNote? _activeTerm;

    private readonly DialogOptions _glossaryDialogOptions = new() { MaxWidth = MaxWidth.Medium, CloseButton = true };
    private readonly DialogOptions _termDialogOptions = new() { MaxWidth = MaxWidth.Small, CloseButton = true };

    private string Locale => GameService.CurrentSession.Locale;
    private bool IsPortuguese => Locale.StartsWith("pt", StringComparison.OrdinalIgnoreCase);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filteredCards.Count / (double)PageSize));

    private List<GameCardModel> CurrentPageCardsList =>
        _filteredCards.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToList();

    protected override void OnInitialized()
    {
        _allCards = GameService.GetAllUnifiedDeckCards().ToList();
        SelectTab(0);
    }

    private async Task NavigateBackToMenu()
    {
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        Navigation.NavigateTo("/");
    }

    private async Task SelectTabAsync(int tabIndex)
    {
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        SelectTab(tabIndex);
    }

    private async Task PreviousPageAsync()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        }
    }

    private async Task NextPageAsync()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
            await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        }
    }

    private void SelectTab(int tabIndex)
    {
        _activeTab = tabIndex;
        _currentPage = 1;

        _filteredCards = _activeTab switch
        {
            0 => _allCards.Where(c => c.CardId.StartsWith("BLD", StringComparison.OrdinalIgnoreCase) ||
                                      c.Category is CardSlotCategory.ShipAndBaseHull or CardSlotCategory.PowerAndThermal).ToList(),
            1 => _allCards.Where(c => c.CardId.StartsWith("ECL", StringComparison.OrdinalIgnoreCase) ||
                                      c.Category == CardSlotCategory.MarshallEclssLoop).ToList(),
            2 => _allCards.Where(c => c.CardId.StartsWith("ENV", StringComparison.OrdinalIgnoreCase) ||
                                      c.Category == CardSlotCategory.EnvironmentAndSuits).ToList(),
            3 => _allCards.Where(c => c.CardId.StartsWith("ARC", StringComparison.OrdinalIgnoreCase) ||
                                      c.Category == CardSlotCategory.OutpostArchitecture).ToList(),
            4 => _allCards.Where(c => c.CardId.StartsWith("SWX", StringComparison.OrdinalIgnoreCase) ||
                                      c.Category == CardSlotCategory.DonkiSpaceWeatherCounter).ToList(),
            _ => _allCards
        };

        _selectedCard = _filteredCards.FirstOrDefault();
    }

    private async Task SelectCard(GameCardModel card)
    {
        _selectedCard = card;
        await AudioService.PlaySoundEffectAsync(SoundEffect.CardDrawFlip);
    }

    private async Task OpenTermDialog(TechnicalTermNote term)
    {
        _activeTerm = term;
        _showTermModal = true;
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
    }

    private async Task CloseTermDialog()
    {
        _showTermModal = false;
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
    }

    private async Task OpenGeneralGlossaryModal()
    {
        _showGlossaryModal = true;
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
    }

    private async Task CloseGeneralGlossaryModal()
    {
        _showGlossaryModal = false;
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
    }
}
