@page "/info"
@namespace PymSpaceOrbit.Shared.Pages
@using PymSpaceOrbit.Shared.Abstractions.Game
@using PymSpaceOrbit.Shared.Components.Cards
@using PymSpaceOrbit.Shared.Models.Game
@inject IGameService GameService
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Pym Space Orbit — @(IsPortuguese ? "Galeria de Card Sets & Sobre" : "Card Sets Gallery & About")</PageTitle>

<div class="info-screen-wrapper">
    <div class="info-screen-canvas">
        <!-- 16:9 Background Graphic from Shared Project -->
        <img src="@PymGameOrbitAssets.ScreenInfoCardSets" alt="Pym Space Orbit Card Sets Gallery" class="info-bg-img" />

        <!-- Top Navigation Bar Placeholders -->
        <div class="info-top-bar">
            <!-- Slot Superior Esquerdo: VOLTAR / BACK -->
            <MudButton Variant="Variant.Filled"
                       Class="info-back-btn"
                       OnClick="@(() => Navigation.NavigateTo("/"))"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Size="Size.Medium">
                @(IsPortuguese ? "VOLTAR" : "BACK")
            </MudButton>

            <!-- 5 Abas Retangulares para Filtrar os 5 Sets -->
            <div class="info-tabs-row">
                <MudButton Variant="@(_activeTab == 0 ? Variant.Filled : Variant.Outlined)"
                           Class="@($"info-deck-tab {(_activeTab == 0 ? "active-tab" : "")}")"
                           OnClick="@(() => SelectTab(0))"
                           StartIcon="@Icons.Material.Filled.Rocket">
                    @(IsPortuguese ? "1. Ship Build" : "1. Ship Build")
                </MudButton>

                <MudButton Variant="@(_activeTab == 1 ? Variant.Filled : Variant.Outlined)"
                           Class="@($"info-deck-tab {(_activeTab == 1 ? "active-tab" : "")}")"
                           OnClick="@(() => SelectTab(1))"
                           StartIcon="@Icons.Material.Filled.WaterDrop">
                    @(IsPortuguese ? "2. ECLSS Loop" : "2. ECLSS Loop")
                </MudButton>

                <MudButton Variant="@(_activeTab == 2 ? Variant.Filled : Variant.Outlined)"
                           Class="@($"info-deck-tab {(_activeTab == 2 ? "active-tab" : "")}")"
                           OnClick="@(() => SelectTab(2))"
                           StartIcon="@Icons.Material.Filled.Public">
                    @(IsPortuguese ? "3. Ambientes" : "3. Environment")
                </MudButton>

                <MudButton Variant="@(_activeTab == 3 ? Variant.Filled : Variant.Outlined)"
                           Class="@($"info-deck-tab {(_activeTab == 3 ? "active-tab" : "")}")"
                           OnClick="@(() => SelectTab(3))"
                           StartIcon="@Icons.Material.Filled.Architecture">
                    @(IsPortuguese ? "4. Decisões Base" : "4. Architecture")
                </MudButton>

                <MudButton Variant="@(_activeTab == 4 ? Variant.Filled : Variant.Outlined)"
                           Class="@($"info-deck-tab {(_activeTab == 4 ? "active-tab" : "")}")"
                           OnClick="@(() => SelectTab(4))"
                           StartIcon="@Icons.Material.Filled.WbTwilight">
                    @(IsPortuguese ? "5. Clima DONKI" : "5. Space Weather")
                </MudButton>
            </div>
        </div>

        <!-- Left 2x4 Grid (Up to 8 Cards + Pagination for 10/12 sets) -->
        <div class="info-left-panel">
            <div class="info-cards-grid">
                @foreach (var card in CurrentPageCards)
                {
                    <div class="info-grid-card-item">
                        <PymGameOrbitCard Card="@card"
                                         Locale="@Locale"
                                         IsSelected="@(card.CardId == _selectedCard?.CardId)"
                                         OnCardClicked="SelectCard" />
                    </div>
                }
            </div>

            <!-- Paginação para Sets de 10 ou 12 Cartas -->
            @if (TotalPages > 1)
            {
                <div class="info-pagination-row">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   Disabled="@(_currentPage <= 1)"
                                   OnClick="@(() => _currentPage--)" />
                    <span class="info-pagination-label">
                        @(IsPortuguese ? $"Página {_currentPage} de {TotalPages}" : $"Page {_currentPage} of {TotalPages}")
                        (@(_filteredCards.Count) @(IsPortuguese ? "cartas no set" : "cards in set"))
                    </span>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   Disabled="@(_currentPage >= TotalPages)"
                                   OnClick="@(() => _currentPage++)" />
                </div>
            }
        </div>

        <!-- Right Inspection Panel: Card Zoom + Kid Summary + Trade-Offs + Technical Glossary -->
        <div class="info-right-panel">
            @if (_selectedCard is not null)
            {
                <div class="inspector-scroll-content">
                    <!-- Zoomed Card Component with Live NASA API Photo -->
                    <div class="inspector-card-preview">
                        <PymGameOrbitCard Card="@_selectedCard"
                                         Locale="@Locale"
                                         CustomStyle="width: 175px; margin: 0 auto;"
                                         OnTermClicked="OpenTermDialog" />
                    </div>

                    <!-- Kid Educational Summary (7–12 years) -->
                    <div class="inspector-section-box">
                        <div class="inspector-box-header" style="color: #FFD700;">
                            <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" Class="mr-1" />
                            <span>@(IsPortuguese ? "Resumo Educativo (7–12 anos)" : "Kid-Friendly Space Science (Ages 7–12)")</span>
                        </div>
                        <p class="inspector-kid-text">
                            @(IsPortuguese ? (string.IsNullOrWhiteSpace(_selectedCard.KidSummaryPtBr) ? _selectedCard.KidSummaryEn : _selectedCard.KidSummaryPtBr)
                                           : _selectedCard.KidSummaryEn)
                        </p>
                    </div>

                    <!-- Trade-offs: Watts, O2, Shielding, Delay -->
                    <div class="inspector-section-box">
                        <div class="inspector-box-header" style="color: #00E5FF;">
                            <MudIcon Icon="@Icons.Material.Filled.Balance" Size="Size.Small" Class="mr-1" />
                            <span>@(IsPortuguese ? "Trade-Offs Biofísicos & Recursos" : "Biophysical Trade-Offs & Resources")</span>
                        </div>
                        <div class="inspector-metrics-grid">
                            <div class="metric-pill">
                                <span class="metric-name">⚡ Watts:</span>
                                <span class="metric-val" style="color: @(_selectedCard.WattBudgetDelta >= 0 ? "#00E676" : "#FF5252");">
                                    @_selectedCard.WattBudgetDelta.ToString("+#,##0;-#,##0;0") W
                                </span>
                            </div>
                            <div class="metric-pill">
                                <span class="metric-name">💧 Oxigênio:</span>
                                <span class="metric-val" style="color: @(_selectedCard.OxygenLitersPerDayDelta >= 0 ? "#00E676" : "#FF5252");">
                                    @_selectedCard.OxygenLitersPerDayDelta.ToString("+#,##0;-#,##0;0") L/d
                                </span>
                            </div>
                            <div class="metric-pill">
                                <span class="metric-name">🛡️ Blindagem:</span>
                                <span class="metric-val" style="color: #00E5FF;">
                                    @_selectedCard.ShieldingGcm2Delta.ToString("+#,##0.0;-#,##0.0;0") g/cm²
                                </span>
                            </div>
                            <div class="metric-pill">
                                <span class="metric-name">⏱️ Atraso Comms:</span>
                                <span class="metric-val" style="color: @(_selectedCard.CommDelaySecDelta <= 0 ? "#00E676" : "#FFB300");">
                                    @_selectedCard.CommDelaySecDelta.ToString("+#,##0;-#,##0;0") s
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Technical Glossary Terms for this Card -->
                    @if (_selectedCard.TechnicalGlossary is not null && _selectedCard.TechnicalGlossary.Count > 0)
                    {
                        <div class="inspector-section-box">
                            <div class="inspector-box-header" style="color: #00E676;">
                                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" Class="mr-1" />
                                <span>@(IsPortuguese ? "Glossário Técnico do Card" : "Card Technical Glossary")</span>
                            </div>
                            <div class="inspector-glossary-list">
                                @foreach (var term in _selectedCard.TechnicalGlossary.Values)
                                {
                                    <div class="glossary-item-card" @onclick="@(() => OpenTermDialog(term))">
                                        <div class="d-flex align-center justify-space-between mb-1">
                                            <span class="glossary-term-badge">@term.Term</span>
                                            <span class="glossary-friendly-name">@(IsPortuguese ? term.KidFriendlyLabelPtBr : term.KidFriendlyLabelEn)</span>
                                        </div>
                                        <p class="glossary-explanation">
                                            @(IsPortuguese ? term.ExplanationPtBr : term.ExplanationEn)
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Botão para Abrir o Modal com o Glossário Geral (ABOUT.md) -->
                    <div class="mt-3 mb-2 text-center">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.LibraryBooks"
                                   OnClick="OpenGeneralGlossaryModal"
                                   Style="border-color: #FFD700; color: #FFD700; font-weight: bold; font-size: 11px;">
                            @(IsPortuguese ? "VER GLOSSÁRIO GERAL COMPLETO (ABOUT.MD)" : "VIEW FULL AEROSPACE GLOSSARY (ABOUT.MD)")
                        </MudButton>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal com o Glossário Geral Completo (ABOUT.md) -->
<MudDialog @bind-Visible="_showGlossaryModal" Options="_glossaryDialogOptions">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Secondary" Class="mr-2" />
            <MudText Typo="Typo.h6" Style="color: #FFD700; font-weight: bold;">
                @(IsPortuguese ? "GLOSSÁRIO GERAL AEROESPACIAL & CLIMA ESPACIAL" : "FULL AEROSPACE & SPACE WEATHER GLOSSARY")
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div style="max-height: 60vh; overflow-y: auto; padding-right: 8px;">
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2" Style="color: #00E5FF;">
                1. Casco, Energia e Estrutura (Ship Build)
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-3" Style="color: #E0F7FA;">
                • <strong>BNNT</strong>: Nanotubos de Nitreto de Boro Hidrogenados com alta densidade de paragem de radiação cósmica galáctica (GCR).<br />
                • <strong>KRUSTY</strong>: Mini-reator nuclear de fissão de 10-40 kWe desenvolvido pela NASA Glenn imune a tempestades de poeira.<br />
                • <strong>iROSA</strong>: Asas solares ultraleves desdobráveis para fornecimento de até 220 kWe.<br />
                • <strong>EDS</strong>: Escudo eletrodinâmico que repele poeira abrasiva de regolito através de campos elétricos multifásicos.<br />
                • <strong>xEMU</strong>: Traje espacial de nova geração da NASA Artemis com maior mobilidade e interfaces SuitPort.
            </MudText>

            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2" Style="color: #00E676;">
                2. Suporte de Vida em Circuito Fechado (Marshall ECLSS)
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-3" Style="color: #E0F7FA;">
                • <strong>WPA / UPA</strong>: Reator catalítico e destilação a vácuo para reciclagem de 98,5% das águas residuais.<br />
                • <strong>BPA</strong>: Processador de salmoura por membrana aquecida elevando a recuperação para até 99,2%.<br />
                • <strong>OGA</strong>: Eletrólise de água por membrana PEM gerando oxigênio puro respirável e hidrogênio.<br />
                • <strong>CDRA</strong>: Removedor térmico com 4 leitos de zeólita 5A para adsorção de CO2 expirado.<br />
                • <strong>Sabatier / Bosch</strong>: Reatores termoquímicos que convertem CO2 e H2 em água e combustível metano (CH4).<br />
                • <strong>PBR</strong>: Fotobiorreator com microalgas Chlorella e Spirulina para fixação biológica de carbono e alimentos.
            </MudText>

            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2" Style="color: #FFB300;">
                3. Habitats e Decisões Arquiteturais na Lua e Marte
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-3" Style="color: #E0F7FA;">
                • <strong>Sinterização de Regolito</strong>: Impressão 3D de abóbadas de solo lunar com sobrecarga de 45 g/cm².<br />
                • <strong>Tubos de Lava em Arsia Mons</strong>: Cavernas vulcânicas naturais em Marte com proteção superior a 68 g/cm².<br />
                • <strong>MOXIE</strong>: Eletrólise de óxido sólido a 800°C produzindo oxigênio direto da atmosfera marciana de CO2.
            </MudText>

            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2" Style="color: #FF5252;">
                4. Clima Espacial & Eventos NASA DONKI
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-3" Style="color: #E0F7FA;">
                • <strong>NASA DONKI</strong>: Telemetria heliosférica em tempo real de erupções solares e tempestades de radiação.<br />
                • <strong>Flares Classe X</strong>: Erupções solares de alta potência que provocam blackouts e tempestades de prótons.<br />
                • <strong>CME & Decréscimo de Forbush</strong>: Ejeções de plasma coronal que modulam a radiação ambiente.
            </MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => _showGlossaryModal = false)">
            @(IsPortuguese ? "Fechar Glossário" : "Close Glossary")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Modal de Detalhe de Termo Técnico Específico -->
<MudDialog @bind-Visible="_showTermModal" Options="_termDialogOptions">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Class="mr-2" />
            <MudText Typo="Typo.h6" Style="color: #00E5FF; font-weight: bold;">
                @_activeTerm?.Term — @(IsPortuguese ? _activeTerm?.KidFriendlyLabelPtBr : _activeTerm?.KidFriendlyLabelEn)
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Style="color: #F0F6FC; line-height: 1.6;">
            @(IsPortuguese ? _activeTerm?.ExplanationPtBr : _activeTerm?.ExplanationEn)
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@(() => _showTermModal = false)">
            @(IsPortuguese ? "Entendi" : "Got it")
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
