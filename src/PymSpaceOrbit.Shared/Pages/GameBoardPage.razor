@page "/play"
@namespace PymSpaceOrbit.Shared.Pages
@using PymSpaceOrbit.Shared.Abstractions.Game
@using PymSpaceOrbit.Shared.Abstractions.ML
@using PymSpaceOrbit.Shared.Components.Cards
@using PymSpaceOrbit.Shared.Models.Game
@using PymSpaceOrbit.Shared.Models.ML
@inject IGameService GameService
@inject IAudioService AudioService
@inject IPymGameOrbitMlModelService MlModelService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Pym Space Orbit — @(IsPortuguese ? "Tabuleiro de Missão" : "Mission Game Board")</PageTitle>

<div class="game-screen-wrapper">
    <!-- Pure CSS Sci-Fi Cockpit Board (Faithful CSS reproduction of ui_screen_gameplay_board.jpg & ui_screen_gameplay_board_with_decks.jpg) -->
    <div class="hud-board-canvas @(Session.Phase == TurnPhase.BuildPhase ? "mode-build-phase" : "mode-turn-phase")">

        <!-- Outer Cockpit Metallic Corner & Edge Accents -->
        <div class="cockpit-corner-tl"></div>
        <div class="cockpit-corner-tr"></div>
        <div class="cockpit-rail-left"></div>
        <div class="cockpit-rail-right"></div>

        <!-- 4 Top Chamfered Resource Meters with Live Telemetry Bars -->
        <div class="hud-top-meters-bay">
            <!-- Meter 1: Energia / Power (Cyan Frame) -->
            <div class="hud-meter-frame meter-frame-cyan">
                <div class="hud-meter-inner">
                    <div class="meter-header">
                        <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" Style="color: #00E5FF;" Class="mr-1" />
                        <span>@(IsPortuguese ? "ENERGIA / POWER" : "POWER / BATTERY")</span>
                    </div>
                    <div class="meter-body">
                        <span class="meter-main-val">@Session.Resources.ElectricalPowerKw.ToString("F1") kWe</span>
                        <span class="meter-sub-val" style="color: @(Session.Resources.OutpostWattBudgetDelta >= 0 ? "#00E676" : "#FF5252");">
                            @Session.Resources.OutpostWattBudgetDelta.ToString("+#,##0;-#,##0;0") W
                        </span>
                    </div>
                    <div class="hud-meter-track">
                        <div class="hud-meter-fill fill-cyan" style="width: @(Math.Clamp(Session.Resources.ElectricalPowerKw / 2.5f, 15f, 100f).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                    </div>
                </div>
            </div>

            <!-- Meter 2: Oxigênio & Água ECLSS (Emerald/Teal Frame) -->
            <div class="hud-meter-frame meter-frame-emerald">
                <div class="hud-meter-inner">
                    <div class="meter-header">
                        <MudIcon Icon="@Icons.Material.Filled.WaterDrop" Size="Size.Small" Style="color: #00E676;" Class="mr-1" />
                        <span>@(IsPortuguese ? "OXIGÊNIO & ÁGUA" : "O2 & WATER LOOP")</span>
                    </div>
                    <div class="meter-body">
                        <span class="meter-main-val">O2: @Session.Resources.OutpostOxygenLitersPerDayDelta.ToString("+#,##0;-#,##0;0") L/d</span>
                        <span class="meter-sub-val">
                            H2O: @Session.Resources.PotableWaterReserveLiters.ToString("F0")L | WPA: @((Session.Resources.WaterRecoveryEfficiency * 100f).ToString("F0"))%
                        </span>
                    </div>
                    <div class="hud-meter-track">
                        <div class="hud-meter-fill fill-emerald" style="width: @(Math.Clamp(Session.Resources.WaterRecoveryEfficiency * 100f, 20f, 100f).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                    </div>
                </div>
            </div>

            <!-- Meter 3: Blindagem & Trajes (Gold/Emerald Frame) -->
            <div class="hud-meter-frame meter-frame-gold">
                <div class="hud-meter-inner">
                    <div class="meter-header">
                        <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Style="color: #FFD700;" Class="mr-1" />
                        <span>@(IsPortuguese ? "BLINDAGEM & TRAJES" : "SHIELDING & SUITS")</span>
                    </div>
                    <div class="meter-body">
                        <span class="meter-main-val">
                            @((Session.Resources.RadShieldingGcm2 + Session.Resources.OutpostShieldingGcm2Delta).ToString("F0")) g/cm²
                        </span>
                        <span class="meter-sub-val">
                            xEMU: @Session.Resources.EvaSuitDurabilityPct.ToString("F0")% | Rad: @Session.Resources.EffectiveRadiationIndex.ToString("F2")x
                        </span>
                    </div>
                    <div class="hud-meter-track">
                        <div class="hud-meter-fill fill-gold" style="width: @(Math.Clamp(Session.Resources.EvaSuitDurabilityPct, 10f, 100f).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                    </div>
                </div>
            </div>

            <!-- Meter 4: Predição Quad-Ensemble ML.NET (Teal/Cyan Frame) -->
            <div class="hud-meter-frame meter-frame-teal">
                <div class="hud-meter-inner">
                    <div class="meter-header">
                        <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" Style="color: #00E5FF;" Class="mr-1" />
                        <span>@(IsPortuguese ? "QUAD-ENSEMBLE ML.NET" : "ML.NET SURROGATE")</span>
                    </div>
                    <div class="meter-body">
                        <span class="meter-main-val" style="color: #FFD700;">
                            @(IsPortuguese ? "Saúde" : "Health"): @((Session.LatestMlPrediction.CrewHealthSurvivalProb * 100f).ToString("F0"))%
                        </span>
                        <span class="meter-sub-val">
                            CH4: @((Session.LatestMlPrediction.FuelYieldRate * 100f).ToString("F0"))% | @Session.LatestMlPrediction.MaxExplorationStayDays.ToString("F0")d
                        </span>
                    </div>
                    <div class="hud-meter-track">
                        <div class="hud-meter-fill fill-teal" style="width: @(Math.Clamp(Session.LatestMlPrediction.CrewHealthSurvivalProb * 100f, 15f, 100f).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                    </div>
                </div>
            </div>
        </div>

        @if (Session.Phase == TurnPhase.BuildPhase)
        {
            <!-- ========================================================================= -->
            <!-- FASE 1: CONSTRUÇÃO INICIAL DA BASE (CSS Reproduction of gameplay_board)   -->
            <!-- ========================================================================= -->
            <div class="hud-build-body">
                <!-- Center-Top Chamfered Status & Instruction Plaque -->
                <div class="hud-build-top-plaque">
                    <div class="hud-build-plaque-inner">
                        <div class="build-banner-title">
                            <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Color="Color.Primary" Size="Size.Small" Class="mr-2" />
                            <span>@(IsPortuguese ? "FASE 1: CONSTRUÇÃO DA NAVE & BASE PYMGAMEORBIT" : "PHASE 1: PYMGAMEORBIT SHIP & OUTPOST BASE ASSEMBLY")</span>
                        </div>
                        <div class="build-banner-subtitle">
                            @(IsPortuguese
                                ? $"Equipe no mínimo {Session.MinimumCardsToBuildBase} cartas da sua mão para fundar a base em {Session.Destination} (Equipadas: {Session.EquippedShipAndBaseCards.Count}/{Session.MinimumCardsToBuildBase})"
                                : $"Equip at least {Session.MinimumCardsToBuildBase} cards from hand to establish outpost at {Session.Destination} (Equipped: {Session.EquippedShipAndBaseCards.Count}/{Session.MinimumCardsToBuildBase})")
                        </div>
                    </div>
                </div>

                <!-- Middle Row: 5 Metallic Platform Card Slots + 2 Right Chamfered Action Plaques -->
                <div class="hud-build-middle-row">
                    <!-- Metallic Platform Holding 5 Illuminated 2:3 Card Slots -->
                    <div class="hud-build-platform-5">
                        @for (int i = 0; i < 5; i++)
                        {
                            int slotIndex = i;
                            var card = slotIndex < Session.EquippedShipAndBaseCards.Count
                                ? Session.EquippedShipAndBaseCards[slotIndex]
                                : null;
                            string slotTheme = slotIndex < 2 ? "slot-neon-cyan" : (slotIndex < 4 ? "slot-neon-emerald" : "slot-neon-gold");

                            <div class="hud-equipped-slot @slotTheme">
                                @if (card is not null)
                                {
                                    <PymGameOrbitCard Card="@card"
                                                     Locale="@Session.Locale"
                                                     CustomStyle="height: 100%; width: auto; max-width: 100%;" />
                                }
                                else
                                {
                                    <div class="empty-slot-placeholder">
                                        <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small" Style="color: rgba(0, 229, 255, 0.5);" />
                                        <span>SLOT @(slotIndex + 1)</span>
                                        <span class="slot-hint">@(IsPortuguese ? "Equipar da Mão" : "Equip from Hand")</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- 2 Right Chamfered Action Plaques (Cyan Top + Gold Bottom) -->
                    <div class="hud-build-right-actions">
                        <div class="hud-action-plaque plaque-cyan">
                            <MudButton Variant="Variant.Text"
                                       Class="hud-action-plaque-btn text-cyan"
                                       OnClick="ConfirmBaseConstruction"
                                       StartIcon="@Icons.Material.Filled.RocketLaunch">
                                @(IsPortuguese ? "CONFIRMAR BASE" : "CONFIRM BASE")
                            </MudButton>
                        </div>

                        <div class="hud-action-plaque plaque-gold">
                            <MudButton Variant="Variant.Text"
                                       Class="hud-action-plaque-btn text-gold"
                                       OnClick="ResetAssembly"
                                       StartIcon="@Icons.Material.Filled.RestartAlt">
                                @(IsPortuguese ? "REINICIAR" : "RESET BASE")
                            </MudButton>
                        </div>
                    </div>
                </div>

                <!-- Bottom Brushed-Steel Hand Dock (Choose Cards from Hand to Equip) -->
                <div class="hud-hand-dock">
                    <div class="hud-hand-dock-header">
                        <span>
                            @(IsPortuguese ? $"MÃO DO ASTRONAUTA ({Session.PlayerHand.Count} cartas disponíveis — clique em uma carta para equipar):"
                                           : $"PLAYER HAND ({Session.PlayerHand.Count} cards available — click a card to equip):")
                        </span>
                    </div>
                    <div class="hud-hand-slots-5">
                        @for (int i = 0; i < 5; i++)
                        {
                            var handCard = i < Session.PlayerHand.Count ? Session.PlayerHand[i] : null;
                            <div class="hud-hand-slot-bay" @onclick="@(async () => { if (handCard is not null) await EquipCard(handCard); })">
                                @if (handCard is not null)
                                {
                                    <PymGameOrbitCard Card="@handCard"
                                                     Locale="@Session.Locale"
                                                     CustomStyle="height: 100%; width: auto; max-width: 100%;" />
                                }
                                else
                                {
                                    <div class="hand-bay-empty">
                                        <span>@(IsPortuguese ? "VAZIO" : "EMPTY")</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- ========================================================================= -->
            <!-- FASES 2 & 3: TABULEIRO COMPLETO COM DECKS, ESCOLHAS & MÃO (CSS HUD)       -->
            <!-- ========================================================================= -->
            <div class="hud-turn-cockpit">
                <!-- Left Column: Draw Pile (Stacked Rocket Back) & Discard Pile -->
                <div class="hud-decks-column">
                    <!-- Draw Pile Well -->
                    <div class="hud-deck-well" title="@(IsPortuguese ? "Pilha de Compra" : "Draw Pile")">
                        <div class="deck-stack-3d">
                            <img src="@PymGameOrbitAssets.CardBack" alt="" class="pile-img" />
                        </div>
                        <div class="pile-badge">
                            <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Small" Class="mr-1" />
                            <span>@Session.DrawPile.Count</span>
                        </div>
                        <span class="pile-label">@(IsPortuguese ? "COMPRA" : "DRAW")</span>
                    </div>

                    <!-- Discard Pile Well -->
                    <div class="hud-deck-well discard-well" title="@(IsPortuguese ? "Pilha de Descarte" : "Discard Pile")">
                        <div class="discard-stack-outline">
                            <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Medium" Style="color: rgba(0, 229, 255, 0.35);" />
                            <span class="pile-number">@Session.DiscardPile.Count</span>
                        </div>
                        <span class="pile-label">@(IsPortuguese ? "DESCARTE" : "DISCARD")</span>
                    </div>
                </div>

                <!-- Center Playfield: 3 Choice Bars + 5 Illuminated Equipped Slots + 5 Hand Slots -->
                <div class="hud-center-playfield">
                    <!-- Top Dilemma & 3 Metallic Choice Bars -->
                    <div class="hud-dilemma-bay">
                        @if (Session.PendingExplorationEvent is not null)
                        {
                            <div class="dilemma-header-strip">
                                <span class="dilemma-title">
                                    🌌 [Turno @Session.CurrentTurn/@Session.MaxCampaignTurns — Dia @Session.CurrentMissionDay.ToString("F0")] @(IsPortuguese ? Session.PendingExplorationEvent.TitlePtBr : Session.PendingExplorationEvent.TitleEn)
                                </span>
                                <span class="dilemma-story">
                                    @(IsPortuguese ? Session.PendingExplorationEvent.StoryPromptPtBr : Session.PendingExplorationEvent.StoryPromptEn)
                                </span>
                            </div>

                            <!-- 3 Horizontal Metallic Choice Bars with Green Side LEDs -->
                            <div class="dilemma-choices-stack">
                                @foreach (var choice in Session.PendingExplorationEvent.Choices.Take(3))
                                {
                                    <div class="hud-choice-bar" @onclick="@(() => MakeExplorationDecision(choice.OptionId))">
                                        <div class="choice-cap-left"></div>
                                        <div class="choice-bar-content">
                                            <div class="choice-label-row">
                                                <MudIcon Icon="@Icons.Material.Filled.Navigation" Size="Size.Small" Class="mr-1" Style="color: #00E5FF;" />
                                                <span class="choice-title">@(IsPortuguese ? choice.LabelPtBr : choice.LabelEn)</span>
                                            </div>
                                            <div class="choice-impacts-row">
                                                <span class="impact-chip" style="color: @(choice.WattCostDelta <= 0 ? "#00E676" : "#FF5252");">
                                                    ⚡@choice.WattCostDelta.ToString("+#,##0;-#,##0;0")W
                                                </span>
                                                <span class="impact-chip" style="color: @(choice.OxygenLitersDelta >= 0 ? "#00E676" : "#FF5252");">
                                                    💧@choice.OxygenLitersDelta.ToString("+#,##0;-#,##0;0")L
                                                </span>
                                                <span class="impact-chip" style="color: #00E5FF;">
                                                    🛡️@choice.ShieldingGcm2Delta.ToString("+#,##0;-#,##0;0")g
                                                </span>
                                                <span class="impact-chip" style="color: @(choice.RadiationDoseSpike <= 0 ? "#00E676" : "#FFB300");">
                                                    ☢️@choice.RadiationDoseSpike.ToString("+#.##;-#.##;0")
                                                </span>
                                                <span class="impact-chip" style="color: #FFD700; font-weight: 800;">
                                                    🔬+@choice.ScienceDiscoveryPointsBonus
                                                </span>
                                            </div>
                                        </div>
                                        <div class="choice-cap-right"></div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Middle: 5 Illuminated Slots for Equipped Base Cards (Cyan, Emerald, Cyan, Emerald, Gold) -->
                    <div class="hud-equipped-row-5">
                        @for (int i = 0; i < 5; i++)
                        {
                            int slotIdx = i;
                            var eqCard = slotIdx < Session.EquippedShipAndBaseCards.Count
                                ? Session.EquippedShipAndBaseCards[slotIdx]
                                : null;
                            string neonClass = slotIdx switch
                            {
                                0 => "slot-neon-cyan",
                                1 => "slot-neon-emerald",
                                2 => "slot-neon-cyan",
                                3 => "slot-neon-emerald",
                                _ => "slot-neon-gold"
                            };

                            <div class="hud-equipped-slot @neonClass">
                                @if (eqCard is not null)
                                {
                                    <PymGameOrbitCard Card="@eqCard"
                                                     Locale="@Session.Locale"
                                                     CustomStyle="height: 100%; width: auto; max-width: 100%;" />
                                }
                                else
                                {
                                    <div class="empty-slot-placeholder-small">
                                        <span>SLOT @(slotIdx + 1)</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Bottom Brushed-Steel Hand Dock: 5 Slots for Player Hand -->
                    <div class="hud-hand-dock">
                        <div class="hud-hand-dock-header">
                            <span>@(IsPortuguese ? $"MÃO DO JOGADOR ({Session.PlayerHand.Count} cartas — clique para jogar)"
                                                 : $"PLAYER HAND ({Session.PlayerHand.Count} cards — click to play)")</span>
                            <span style="color: #FFD700;">
                                @(IsPortuguese ? $"Jogadas no turno: {Session.CardsPlayedThisTurn}/{Session.MaxCardsPlayedPerTurn}"
                                               : $"Played this turn: {Session.CardsPlayedThisTurn}/{Session.MaxCardsPlayedPerTurn}")
                            </span>
                        </div>
                        <div class="hud-hand-slots-5">
                            @for (int i = 0; i < 5; i++)
                            {
                                var cardInHand = i < Session.PlayerHand.Count ? Session.PlayerHand[i] : null;
                                <div class="hud-hand-slot-bay" @onclick="@(async () => { if (cardInHand is not null) await PlayCard(cardInHand); })">
                                    @if (cardInHand is not null)
                                    {
                                        <PymGameOrbitCard Card="@cardInHand"
                                                         Locale="@Session.Locale"
                                                         CustomStyle="height: 100%; width: auto; max-width: 100%;" />
                                    }
                                    else
                                    {
                                        <div class="hand-bay-empty">
                                            <span>@(IsPortuguese ? "VAZIO" : "EMPTY")</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Right Column: 2 Vertical Brushed-Steel Action Plaques -->
                <div class="hud-right-plaques-column">
                    <div class="hud-steel-plaque" @onclick="OpenJournalModal">
                        <div class="steel-plaque-led-top"></div>
                        <div class="steel-plaque-body">
                            <MudIcon Icon="@Icons.Material.Filled.HistoryEdu" Size="Size.Large" Style="color: #00E5FF;" />
                            <span class="steel-plaque-title">@(IsPortuguese ? "DIÁRIO DE BORDO" : "MISSION LOG")</span>
                            <span class="steel-plaque-sub">@(IsPortuguese ? $"{Session.MissionJournalLogs.Count} registros" : $"{Session.MissionJournalLogs.Count} entries")</span>
                        </div>
                        <div class="steel-plaque-led-bottom"></div>
                    </div>

                    <div class="hud-steel-plaque" @onclick="DrawNewDilemma">
                        <div class="steel-plaque-led-top"></div>
                        <div class="steel-plaque-body">
                            <MudIcon Icon="@Icons.Material.Filled.Casino" Size="Size.Large" Style="color: #FFD700;" />
                            <span class="steel-plaque-title">@(IsPortuguese ? "NOVO EVENTO" : "DRAW EVENT")</span>
                            <span class="steel-plaque-sub">@(IsPortuguese ? "Sortear Dilema" : "Next Dilemma")</span>
                        </div>
                        <div class="steel-plaque-led-bottom"></div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal / Overlay dos 4 Desfechos da Missão (Fase 4: MissionEnded) -->
<MudDialog @bind-Visible="_showEndingModal" Options="_endingDialogOptions">
    <TitleContent>
        <div class="d-flex align-center">
            @if (Session.Outcome == MissionEndingOutcome.SuccessNominalReturn)
            {
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Secondary" Size="Size.Large" Class="mr-2" />
                <MudText Typo="Typo.h5" Style="color: #FFD700; font-weight: 800;">
                    @(IsPortuguese ? "MISSÃO CONCLUÍDA COM SUCESSO!" : "MISSION ACCOMPLISHED — NOMINAL RETURN!")
                </MudText>
            }
            else if (Session.Outcome == MissionEndingOutcome.GameOverDonkiSolarStormRadiation)
            {
                <MudIcon Icon="@Icons.Material.Filled.WbTwilight" Color="Color.Warning" Size="Size.Large" Class="mr-2" />
                <MudText Typo="Typo.h5" Style="color: #FFB300; font-weight: 800;">
                    @(IsPortuguese ? "GAME OVER: TEMPESTADE SOLAR NASA DONKI!" : "GAME OVER: NASA DONKI SOLAR STORM!")
                </MudText>
            }
            else if (Session.Outcome == MissionEndingOutcome.GameOverEclssAndSuitCollapse)
            {
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Large" Class="mr-2" />
                <MudText Typo="Typo.h5" Style="color: #FF5252; font-weight: 800;">
                    @(IsPortuguese ? "GAME OVER: COLAPSO ECLSS E DESGASTE DE TRAJES!" : "GAME OVER: ECLSS & SPACESUIT COLLAPSE!")
                </MudText>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Air" Color="Color.Error" Size="Size.Large" Class="mr-2" />
                <MudText Typo="Typo.h5" Style="color: #FF5252; font-weight: 800;">
                    @(IsPortuguese ? "GAME OVER: ACIDOSE CO2 E ESGOTAMENTO VITAL!" : "GAME OVER: CDRA CO2 ACIDODIS & STARVATION!")
                </MudText>
            }
        </div>
    </TitleContent>
    <DialogContent>
        <div class="ending-modal-body">
            <p class="ending-narrative-text">
                @_latestOutcomeNarrative
            </p>

            <div class="ending-telemetry-grid">
                <div class="ending-stat-box">
                    <span class="stat-lbl">@(IsPortuguese ? "Pontos Científicos:" : "Science Discovery:")</span>
                    <span class="stat-num" style="color: #FFD700;">@Session.ScienceDiscoveryPoints PTS</span>
                </div>
                <div class="ending-stat-box">
                    <span class="stat-lbl">@(IsPortuguese ? "Saúde Tripulação:" : "Crew Health ML:")</span>
                    <span class="stat-num" style="color: #00E676;">@((Session.LatestMlPrediction.CrewHealthSurvivalProb * 100f).ToString("F1"))%</span>
                </div>
                <div class="ending-stat-box">
                    <span class="stat-lbl">@(IsPortuguese ? "Confiabilidade:" : "Hardware Reliability:")</span>
                    <span class="stat-num" style="color: #00E5FF;">@((Session.LatestMlPrediction.SystemReliabilityIndex * 100f).ToString("F1"))%</span>
                </div>
                <div class="ending-stat-box">
                    <span class="stat-lbl">@(IsPortuguese ? "Dias de Estadia:" : "Max Stay Days:")</span>
                    <span class="stat-num" style="color: #FFB300;">@Session.LatestMlPrediction.MaxExplorationStayDays.ToString("F0") d</span>
                </div>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ReturnToMainMenu">
            @(IsPortuguese ? "MENU PRINCIPAL" : "MAIN MENU")
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="RestartGame"
                   StartIcon="@Icons.Material.Filled.Replay"
                   Style="font-weight: bold; background: linear-gradient(90deg, #00E5FF, #0097A7); color: #000;">
            @(IsPortuguese ? "JOGAR NOVAMENTE" : "PLAY AGAIN")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Modal do Diário de Bordo / Mission Log -->
<MudDialog @bind-Visible="_showJournalModal" Options="_journalDialogOptions">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6" Style="color: #00E5FF; font-weight: bold;">
                @(IsPortuguese ? "DIÁRIO DE BORDO DA MISSÃO" : "MISSION TELEMETRY JOURNAL")
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div style="max-height: 50vh; overflow-y: auto;">
            @if (Session.MissionJournalLogs.Count == 0)
            {
                <MudText Typo="Typo.body2" Style="color: #8B949E;">
                    @(IsPortuguese ? "Nenhum registro ainda." : "No entries logged yet.")
                </MudText>
            }
            else
            {
                <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Start">
                    @foreach (var log in Enumerable.Reverse(Session.MissionJournalLogs))
                    {
                        <MudTimelineItem Color="Color.Info" Size="Size.Small">
                            <MudText Typo="Typo.body2" Style="color: #F0F6FC;">@log</MudText>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            }
