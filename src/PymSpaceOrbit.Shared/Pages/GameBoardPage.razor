@code {
    private bool _showEndingModal = false;
    private bool _showJournalModal = false;
    private string _latestOutcomeNarrative = string.Empty;

    private readonly DialogOptions _endingDialogOptions = new() { MaxWidth = MaxWidth.Medium, CloseButton = false };
    private readonly DialogOptions _journalDialogOptions = new() { MaxWidth = MaxWidth.Small, CloseButton = true };

    private GameSessionState Session => GameService.CurrentSession;
    private bool IsPortuguese => Session.Locale.StartsWith("pt", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        if (Session.EquippedShipAndBaseCards.Count == 0 && Session.PlayerHand.Count == 0)
        {
            await GameService.StartNewCampaignAsync(
                Session.Destination,
                Session.CrewCount,
                Session.MinimumCardsToBuildBase,
                Session.Locale);
        }

        if (Session.Phase != TurnPhase.BuildPhase && Session.PendingExplorationEvent is null)
        {
            GameService.DrawTurnExplorationEvent();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AudioService.InitializeAsync();
            await AudioService.SyncGameplayMusicAsync(Session);
        }
    }

    private async Task EquipCard(GameCardModel card)
    {
        if (GameService.PlayCardFromHand(card.CardId, out var msg))
        {
            Snackbar.Add(msg, Severity.Success, c => { c.ShowCloseIcon = false; c.VisibleStateDuration = 1800; });
            await AudioService.TriggerCardEquippedAudioAsync(card, Session.Destination);
        }
        else
        {
            Snackbar.Add(msg, Severity.Warning, c => { c.ShowCloseIcon = true; });
            await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        }
    }

    private async Task PlayCard(GameCardModel card)
    {
        if (GameService.PlayCardFromHand(card.CardId, out var msg))
        {
            Snackbar.Add(msg, Severity.Success, c => { c.ShowCloseIcon = false; c.VisibleStateDuration = 1800; });
            await AudioService.TriggerCardEquippedAudioAsync(card, Session.Destination);
        }
        else
        {
            Snackbar.Add(msg, Severity.Warning, c => { c.ShowCloseIcon = true; });
            await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        }
    }

    private async Task ConfirmBaseConstruction()
    {
        if (GameService.CompleteInitialBaseConstruction(out var msg))
        {
            Snackbar.Add(msg, Severity.Success, c => { c.ShowCloseIcon = true; c.VisibleStateDuration = 3000; });
            await AudioService.PlaySoundEffectAsync(SoundEffect.StageTransitionRiser);
            if (Session.PendingExplorationEvent is not null)
            {
                await AudioService.TriggerExplorationEventAudioAsync(Session.PendingExplorationEvent, Session);
            }
            else
            {
                await AudioService.SyncGameplayMusicAsync(Session);
            }
        }
        else
        {
            Snackbar.Add(msg, Severity.Error, c => { c.ShowCloseIcon = true; });
            await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        }
    }

    private async Task ResetAssembly()
    {
        foreach (var c in Session.EquippedShipAndBaseCards.ToList())
        {
            Session.PlayerHand.Add(c);
        }
        Session.EquippedShipAndBaseCards.Clear();
        Session.CardsPlayedThisTurn = 0;
        await AudioService.PlaySoundEffectAsync(SoundEffect.CardDrawFlip);
        Snackbar.Add(IsPortuguese ? "Montagem reiniciada. Cartas retornadas à mão." : "Assembly reset. Cards returned to hand.", Severity.Info);
    }

    private async Task MakeExplorationDecision(string optionId)
    {
        var activeEvent = Session.PendingExplorationEvent ?? GameService.DrawTurnExplorationEvent();
        var selectedOption = activeEvent.Choices.FirstOrDefault(o => o.OptionId.Equals(optionId, StringComparison.OrdinalIgnoreCase))
                             ?? activeEvent.Choices[0];

        var result = GameService.ResolveExplorationDecisionAndAdvanceTurn(optionId);

        string outcomeMsg = IsPortuguese ? result.OutcomeSummaryPtBr : result.OutcomeSummaryEn;
        string lesson = IsPortuguese ? result.ScienceLessonLearnedPtBr : result.ScienceLessonLearnedEn;

        if (result.Outcome != MissionEndingOutcome.InProgress)
        {
            _latestOutcomeNarrative = $"{outcomeMsg}\n\n📚 {lesson}";
            _showEndingModal = true;
        }
        else
        {
            Snackbar.Add(outcomeMsg, Severity.Info, c => { c.VisibleStateDuration = 3500; });
        }

        await AudioService.TriggerExplorationDecisionAudioAsync(activeEvent, selectedOption, result, Session);
    }

    private async Task DrawNewDilemma()
    {
        var drawnEvent = GameService.DrawTurnExplorationEvent();
        Snackbar.Add(IsPortuguese ? "Novo evento espacial sorteado!" : "New space exploration challenge drawn!", Severity.Normal);
        await AudioService.PlaySoundEffectAsync(SoundEffect.CardDrawFlip);
        await AudioService.TriggerExplorationEventAudioAsync(drawnEvent, Session);
    }

    private async Task OpenJournalModal()
    {
        _showJournalModal = true;
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
    }

    private async Task CloseJournalModal()
    {
        _showJournalModal = false;
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
    }

    private async Task ReturnToMainMenu()
    {
        _showEndingModal = false;
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        Navigation.NavigateTo("/");
    }

    private async Task RestartGame()
    {
        _showEndingModal = false;
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        await GameService.StartNewCampaignAsync(
            Session.Destination,
            Session.CrewCount,
            Session.MinimumCardsToBuildBase,
            Session.Locale);
        await AudioService.PlaySoundEffectAsync(SoundEffect.CardDrawFlip);
        await AudioService.SyncGameplayMusicAsync(Session);
    }
}
