@page "/"
@page "/menu"
@namespace PymSpaceOrbit.Shared.Pages
@using PymSpaceOrbit.Shared.Abstractions.Game
@using PymSpaceOrbit.Shared.Models.Game
@implements IDisposable
@inject IGameService GameService
@inject IAudioService AudioService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ILocalizer<MainMenuPage> L
@inject LocalizationState Localization

<PageTitle>Pym Space Orbit — @L["Home"]</PageTitle>

<div class="menu-screen-wrapper">
    <div class="menu-screen-canvas">
        <!-- 16:9 Cosmic Artwork Background from Shared Project -->
        <img src="@PymGameOrbitAssets.ScreenMainMenu" alt="" class="menu-bg-img" />

        <!-- Top Metallic Banner: Precisely Aligned Inside the Hexagonal Plaque of ui_screen_main_menu.jpg -->
        <div class="menu-top-banner">
            <h1 class="menu-game-title">PYM SPACE ORBIT</h1>
            <p class="menu-game-subtitle">
                @L["MissionSubtitle"]
            </p>
        </div>

        <!-- 4 Stacked Sci-Fi Chamfered Button Plaques (Pure CSS Metallic HUD Reproduction) -->
        <div class="menu-buttons-column">
            <!-- 1. JOGAR / PLAY -->
            <div class="hud-menu-btn-frame frame-cyan">
                <MudButton Variant="Variant.Text"
                           Class="menu-glass-btn btn-play"
                           OnClick="OpenPlayDialog"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Size="Size.Large">
                    @L["PlayButton"]
                </MudButton>
            </div>

            <!-- 2. MODO CONSTRUÇÃO / BASE BUILDER -->
            <div class="hud-menu-btn-frame frame-emerald">
                <MudButton Variant="Variant.Text"
                           Class="menu-glass-btn btn-builder"
                           OnClick="StartBaseBuilderMode"
                           StartIcon="@Icons.Material.Filled.BuildCircle"
                           Size="Size.Large">
                    @L["BaseBuilder"]
                </MudButton>
            </div>

            <!-- 3. SOBRE & CARD SETS / ABOUT & DECKS -->
            <div class="hud-menu-btn-frame frame-gold">
                <MudButton Variant="Variant.Text"
                           Class="menu-glass-btn btn-info"
                           OnClick="NavigateToInfo"
                           StartIcon="@Icons.Material.Filled.CollectionsBookmark"
                           Size="Size.Large">
                    @L["AboutDecks"]
                </MudButton>
            </div>

            <!-- 4. OPÇÕES / OPTIONS -->
            <div class="hud-menu-btn-frame frame-blue">
                <MudButton Variant="Variant.Text"
                           Class="menu-glass-btn btn-options"
                           OnClick="NavigateToOptions"
                           StartIcon="@Icons.Material.Filled.Settings"
                           Size="Size.Large">
                    @L["Options"]
                </MudButton>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Início de Missão / New Campaign Dialog -->
<MudDialog @bind-Visible="_showLaunchModal" Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6" Style="color: #00E5FF; font-weight: bold;">
                @L["NewMissionTitle"]
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-3" Style="color: #8B949E;">
            @L["NewMissionPrompt"]
        </MudText>

        <!-- Destination Selector -->
        <MudText Typo="Typo.body2" Class="font-weight-bold mb-1" Style="color: #FFD700;">
            @L["MissionDestination"]
        </MudText>
        <MudRadioGroup @bind-Value="_selectedDestination" T="OutpostDestination" Class="d-flex flex-wrap justify-space-between mb-4">
            <MudRadio Value="OutpostDestination.ISS" Color="Color.Primary" Dense="true">
                <span style="font-weight: 600;">🛰️ ISS</span>
                <span style="font-size: 11px; color: #8B949E; display: block;">(LEO 414 km / 8 @L["Turns"])</span>
            </MudRadio>
            <MudRadio Value="OutpostDestination.Moon" Color="Color.Secondary" Dense="true">
                <span style="font-weight: 600;">🌕 @L["Moon"]</span>
                <span style="font-size: 11px; color: #8B949E; display: block;">(Artemis Gateway / 10 @L["Turns"])</span>
            </MudRadio>
            <MudRadio Value="OutpostDestination.Mars" Color="Color.Error" Dense="true">
                <span style="font-weight: 600;">🔴 @L["Mars"]</span>
                <span style="font-size: 11px; color: #8B949E; display: block;">(ISRU Surface / 12 @L["Turns"])</span>
            </MudRadio>
        </MudRadioGroup>

        <!-- Crew Count -->
        <div class="mb-4">
            <div class="d-flex justify-space-between align-center mb-1">
                <MudText Typo="Typo.body2" Style="color: #00E676; font-weight: 600;">
                    @L["CrewCount"]
                </MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined">
                    @_crewCount @L["Astronauts"]
                </MudChip>
            </div>
            <MudSlider T="int" Min="1" Max="16" @bind-Value="_crewCount" Color="Color.Tertiary" ValueLabel="true" />
        </div>

        <!-- Minimum Cards to Build Base -->
        <div class="mb-2">
            <div class="d-flex justify-space-between align-center mb-1">
                <MudText Typo="Typo.body2" Style="color: #00E5FF; font-weight: 600;">
                    @L["MinBaseCards"]
                </MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                    @_minCards @L["CardsCount"]
                </MudChip>
            </div>
            <MudSlider T="int" Min="3" Max="8" @bind-Value="_minCards" Color="Color.Primary" ValueLabel="true" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="ClosePlayDialog" Color="Color.Default" Variant="Variant.Text">
            @L["Cancel"]
        </MudButton>
        <MudButton OnClick="LaunchCampaign"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Launch"
                   Style="font-weight: bold; background: linear-gradient(90deg, #00E5FF, #0097A7); color: #000;">
            @L["LaunchMission"]
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .menu-screen-wrapper {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #060911;
        padding: 12px;
        box-sizing: border-box;
        min-height: calc(100vh - 48px);
    }

    .menu-screen-canvas {
        position: relative;
        width: 100%;
        max-width: 1440px;
        height: 80svh;
        aspect-ratio: auto;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.85), 0 0 30px rgba(0, 229, 255, 0.15);
        border: 1px solid rgba(0, 229, 255, 0.25);
        background-color: #050811;
    }

    .menu-bg-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: fill;
        pointer-events: none;
        z-index: 1;
    }

    /* Exact Inner Coordinates of the Top Metallic Hexagonal Plaque in ui_screen_main_menu.jpg */
    .menu-top-banner {
        position: absolute;
        top: 8.8%;
        left: 28.2%;
        width: 43.6%;
        height: 14.5%;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        pointer-events: none;
        padding: 0 12px;
        box-sizing: border-box;
    }

    .menu-game-title {
        margin: 0;
        padding: 0;
        font-family: 'Roboto', 'Segoe UI', sans-serif;
        font-weight: 900;
        font-size: clamp(16px, 2.5vw, 36px);
        letter-spacing: 3.5px;
        color: #FFFFFF;
        text-shadow: 0 0 14px rgba(0, 229, 255, 0.85), 0 2px 4px rgba(0, 0, 0, 0.95);
        text-transform: uppercase;
        background: linear-gradient(180deg, #FFFFFF 20%, #00E5FF 95%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        line-height: 1.1;
    }

    .menu-game-subtitle {
        margin: 3px 0 0 0;
        padding: 0;
        font-family: 'Roboto', 'Segoe UI', sans-serif;
        font-weight: 600;
        font-size: clamp(8.5px, 0.95vw, 13px);
        letter-spacing: 1px;
        color: #FFD700;
        text-shadow: 0 0 10px rgba(255, 215, 0, 0.6), 0 1px 3px rgba(0, 0, 0, 0.95);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }

    /* 4 Stacked Sci-Fi Chamfered Button Plaques Centered Below the Banner */
    .menu-buttons-column {
        position: absolute;
        top: 38%;
        left: 33.5%;
        width: 33%;
        height: 50%;
        z-index: 3;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 3.5%;
    }

    .hud-menu-btn-frame {
        flex: 1;
        position: relative;
        display: flex;
        padding: 2px;
        background: linear-gradient(135deg, rgba(140, 165, 195, 0.75) 0%, rgba(45, 65, 90, 0.85) 50%, rgba(140, 165, 195, 0.75) 100%);
        clip-path: polygon(14px 0%, calc(100% - 14px) 0%, 100% 14px, 100% calc(100% - 14px), calc(100% - 14px) 100%, 14px 100%, 0% calc(100% - 14px), 0% 14px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.75);
        transition: transform 0.2s ease, filter 0.2s ease;
    }

    .hud-menu-btn-frame::before {
        content: "";
        position: absolute;
        top: 0;
        left: 22%;
        width: 56%;
        height: 2.5px;
        background: #00E5FF;
        box-shadow: 0 0 10px #00E5FF;
        z-index: 2;
        pointer-events: none;
    }

    .hud-menu-btn-frame::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 22%;
        width: 56%;
        height: 2.5px;
        background: #00E5FF;
        box-shadow: 0 0 10px #00E5FF;
        z-index: 2;
        pointer-events: none;
    }

    .frame-emerald::before, .frame-emerald::after {
        background: #00E676;
        box-shadow: 0 0 10px #00E676;
    }

    .frame-gold::before, .frame-gold::after {
        background: #FFD700;
        box-shadow: 0 0 10px #FFD700;
    }

    .hud-menu-btn-frame:hover {
        transform: scale(1.03);
        filter: brightness(1.18);
    }

    .menu-glass-btn {
        flex: 1;
        width: 100%;
        height: 100%;
        background: linear-gradient(180deg, rgba(12, 26, 46, 0.88) 0%, rgba(6, 14, 28, 0.94) 100%) !important;
        backdrop-filter: blur(10px);
        clip-path: polygon(13px 0%, calc(100% - 13px) 0%, 100% 13px, 100% calc(100% - 13px), calc(100% - 13px) 100%, 13px 100%, 0% calc(100% - 13px), 0% 13px);
        border: 1px solid rgba(0, 229, 255, 0.4) !important;
        border-radius: 0 !important;
        color: #FFFFFF !important;
        font-family: 'Roboto', 'Segoe UI', sans-serif;
        font-weight: 800 !important;
        letter-spacing: 2px !important;
        font-size: clamp(11px, 1.25vw, 17px) !important;
        text-transform: uppercase !important;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
        transition: all 0.2s ease !important;
    }

    .btn-play:hover {
        background: linear-gradient(180deg, rgba(0, 229, 255, 0.3) 0%, rgba(6, 20, 38, 0.92) 100%) !important;
        color: #00E5FF !important;
    }

    .btn-builder:hover {
        background: linear-gradient(180deg, rgba(0, 230, 118, 0.28) 0%, rgba(6, 24, 20, 0.92) 100%) !important;
        color: #00E676 !important;
    }

    .btn-info:hover {
        background: linear-gradient(180deg, rgba(255, 215, 0, 0.25) 0%, rgba(28, 22, 6, 0.92) 100%) !important;
        color: #FFD700 !important;
    }

    .btn-options:hover {
        background: linear-gradient(180deg, rgba(0, 176, 255, 0.28) 0%, rgba(6, 18, 36, 0.92) 100%) !important;
        color: #80D8FF !important;
    }
</style>

@code {
    private bool _showLaunchModal = false;
    private OutpostDestination _selectedDestination = OutpostDestination.Moon;
    private int _crewCount = 4;
    private int _minCards = 5;

    private readonly DialogOptions _dialogOptions = new()
    {
        CloseOnEscapeKey = true,
        BackdropClick = true,
        MaxWidth = MaxWidth.Small
    };

    private bool IsPortuguese => GameService.CurrentSession.Locale.StartsWith("pt", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Localization.CultureChanged += HandleCultureChanged;
        _selectedDestination = GameService.CurrentSession.Destination;
        _crewCount = GameService.CurrentSession.CrewCount;
        _minCards = GameService.CurrentSession.MinimumCardsToBuildBase;
    }

    private void HandleCultureChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Localization.CultureChanged -= HandleCultureChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AudioService.InitializeAsync();
            await AudioService.SyncScreenMusicAsync("/menu", GameService.CurrentSession);
        }
    }

    private async Task OpenPlayDialog()
    {
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        _selectedDestination = GameService.CurrentSession.Destination;
        _crewCount = GameService.CurrentSession.CrewCount;
        _minCards = GameService.CurrentSession.MinimumCardsToBuildBase;
        _showLaunchModal = true;
    }

    private async Task ClosePlayDialog()
    {
        _showLaunchModal = false;
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
    }

    private async Task NavigateToInfo()
    {
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        Navigation.NavigateTo("/info");
    }

    private async Task NavigateToOptions()
    {
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        Navigation.NavigateTo("/options");
    }

    private async Task LaunchCampaign()
    {
        _showLaunchModal = false;
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        await GameService.StartNewCampaignAsync(
            _selectedDestination,
            _crewCount,
            _minCards,
            GameService.CurrentSession.Locale);
        Navigation.NavigateTo("/play");
    }

    private async Task StartBaseBuilderMode()
    {
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        await GameService.StartNewCampaignAsync(
            GameService.CurrentSession.Destination,
            GameService.CurrentSession.CrewCount,
            GameService.CurrentSession.MinimumCardsToBuildBase,
            GameService.CurrentSession.Locale);
        GameService.CurrentSession.Phase = TurnPhase.BuildPhase;
        Navigation.NavigateTo("/play");
    }
}
