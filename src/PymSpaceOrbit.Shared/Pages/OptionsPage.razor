@page "/options"
@namespace PymSpaceOrbit.Shared.Pages
@using PymSpaceOrbit.Shared.Abstractions.Game
@using PymSpaceOrbit.Shared.Abstractions.ML
@using PymSpaceOrbit.Shared.Models.Game
@inject IGameService GameService
@inject IPymGameOrbitMlModelService MlModelService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Pym Space Orbit — @(IsPortuguese ? "Opções" : "Options")</PageTitle>

<div class="options-screen-wrapper">
    <div class="options-screen-canvas">
        <!-- 16:9 Background Graphic from Shared Project -->
        <img src="@PymGameOrbitAssets.ScreenOptions" alt="Pym Space Orbit Options Screen" class="options-bg-img" />

        <!-- Top Title Bar Placeholder -->
        <div class="options-top-title">
            <h1 class="options-title-text">
                @(IsPortuguese ? "CONFIGURAÇÕES DA MISSÃO & TELEMETRIA" : "MISSION SETTINGS & TELEMETRY")
            </h1>
            <p class="options-subtitle-text">
                @(IsPortuguese ? "Parâmetros Biofísicos ML.NET, Conexões NASA e Preferências"
                               : "ML.NET Biophysical Parameters, NASA Connectivity & Preferences")
            </p>
        </div>

        <!-- 4 Central Horizontal Rows -->
        <div class="options-rows-container">
            <!-- Row 1: Idioma / Language -->
            <div class="options-row">
                <div class="options-row-label">
                    <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" Color="Color.Primary" Class="mr-2" />
                    <span>@(IsPortuguese ? "Idioma da Missão / Language:" : "Mission Language / Idioma:")</span>
                </div>
                <div class="options-row-control">
                    <MudSelect T="string" @bind-Value="_selectedLocale"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Class="options-input">
                        <MudSelectItem Value="@("pt-BR")">🇧🇷 Português (Brasil)</MudSelectItem>
                        <MudSelectItem Value="@("en-US")">🇺🇸 English (United States)</MudSelectItem>
                    </MudSelect>
                </div>
            </div>

            <!-- Row 2: Destino Padrão & Tamanho da Tripulação -->
            <div class="options-row">
                <div class="options-row-label">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Color="Color.Tertiary" Class="mr-2" />
                    <span>@(IsPortuguese ? "Tripulação da Nave (Crew Size):" : "Outpost Crew Count (1-16):")</span>
                    <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled" Class="ml-2">
                        @_crewCount @(IsPortuguese ? "astronautas" : "astronauts")
                    </MudChip>
                </div>
                <div class="options-row-control">
                    <MudSlider T="int" Min="1" Max="16" @bind-Value="_crewCount" Color="Color.Tertiary" ValueLabel="true" />
                </div>
            </div>

            <!-- Row 3: Mínimo de Cartas para Construir a Base -->
            <div class="options-row">
                <div class="options-row-label">
                    <MudIcon Icon="@Icons.Material.Filled.DashboardCustomize" Size="Size.Small" Color="Color.Secondary" Class="mr-2" />
                    <span>@(IsPortuguese ? "Min. Cartas Construção da Base:" : "Min. Base Build Cards (3-8):")</span>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled" Class="ml-2">
                        @_minBaseCards @(IsPortuguese ? "cartas" : "cards")
                    </MudChip>
                </div>
                <div class="options-row-control">
                    <MudSlider T="int" Min="3" Max="8" @bind-Value="_minBaseCards" Color="Color.Secondary" ValueLabel="true" />
                </div>
            </div>

            <!-- Row 4: Sincronização Ao Vivo NASA DONKI & Imagens API -->
            <div class="options-row">
                <div class="options-row-label">
                    <MudIcon Icon="@Icons.Material.Filled.CloudSync" Size="Size.Small" Color="Color.Info" Class="mr-2" />
                    <span>@(IsPortuguese ? "Sincronização Ao Vivo NASA API:" : "Live NASA DONKI & Image Sync:")</span>
                </div>
                <div class="options-row-control">
                    <MudSwitch T="bool" @bind-Value="_liveNasaSync"
                               Color="Color.Info"
                               Label="@(_liveNasaSync ? (IsPortuguese ? "Ativado (images-api.nasa.gov)" : "Enabled (images-api.nasa.gov)") : (IsPortuguese ? "Desativado (Cache Estático)" : "Disabled (Static Cache)"))" />
                </div>
            </div>
        </div>

        <!-- 2 Bottom Buttons Side by Side: VOLTAR & SALVAR -->
        <div class="options-bottom-actions">
            <!-- VOLTAR / BACK -->
            <MudButton Variant="Variant.Filled"
                       Class="options-action-btn btn-back"
                       OnClick="@(() => Navigation.NavigateTo("/"))"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Size="Size.Large">
                @(IsPortuguese ? "VOLTAR" : "BACK")
            </MudButton>

            <!-- SALVAR / SAVE -->
            <MudButton Variant="Variant.Filled"
                       Class="options-action-btn btn-save"
                       OnClick="SaveOptions"
                       StartIcon="@Icons.Material.Filled.CheckCircle"
                       Size="Size.Large">
                @(IsPortuguese ? "SALVAR" : "SAVE")
            </MudButton>
        </div>
    </div>
</div>

<style>
    .options-screen-wrapper {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #060911;
        padding: 12px;
        box-sizing: border-box;
        min-height: calc(100vh - 48px);
    }

    .options-screen-canvas {
        position: relative;
        width: 100%;
        max-width: 1440px;
        aspect-ratio: 16 / 9;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.85), 0 0 30px rgba(0, 229, 255, 0.15);
        border: 1px solid rgba(0, 229, 255, 0.25);
        background-color: #050811;
    }

    .options-bg-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none;
        z-index: 1;
    }

    /* Top Title Bar */
    .options-top-title {
        position: absolute;
        top: 8.5%;
        left: 14%;
        width: 72%;
        height: 14%;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        pointer-events: none;
    }

    .options-title-text {
        margin: 0;
        padding: 0;
        font-family: 'Roboto', 'Segoe UI', sans-serif;
        font-weight: 800;
        font-size: clamp(16px, 2.4vw, 32px);
        letter-spacing: 3px;
        color: #FFFFFF;
        text-shadow: 0 0 12px rgba(0, 229, 255, 0.75), 0 2px 4px rgba(0, 0, 0, 0.9);
        text-transform: uppercase;
        background: linear-gradient(180deg, #FFFFFF 30%, #00E5FF 90%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .options-subtitle-text {
        margin: 2px 0 0 0;
        padding: 0;
        font-size: clamp(9px, 1.1vw, 14px);
        letter-spacing: 1.2px;
        color: #FFD700;
        text-shadow: 0 0 8px rgba(255, 215, 0, 0.5);
    }

    /* 4 Central Horizontal Rows */
    .options-rows-container {
        position: absolute;
        top: 28.5%;
        left: 13%;
        width: 74%;
        height: 48%;
        z-index: 3;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .options-row {
        flex: 1;
        max-height: 22%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(10, 18, 36, 0.65);
        border: 1px solid rgba(0, 229, 255, 0.35);
        border-radius: 8px;
        padding: 0 16px;
        margin-bottom: 8px;
        backdrop-filter: blur(6px);
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.4);
    }

    .options-row-label {
        flex: 0 0 45%;
        display: flex;
        align-items: center;
        font-weight: 700;
        font-size: clamp(10px, 1.1vw, 15px);
        color: #F0F6FC;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
    }

    .options-row-control {
        flex: 0 0 50%;
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    .options-input {
        width: 100%;
        max-width: 280px;
    }

    /* 2 Bottom Buttons Side by Side */
    .options-bottom-actions {
        position: absolute;
        top: 80.5%;
        left: 20%;
        width: 60%;
        height: 11%;
        z-index: 3;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8%;
    }

    .options-action-btn {
        flex: 1;
        height: 100%;
        background: rgba(8, 16, 32, 0.6) !important;
        backdrop-filter: blur(8px);
        border-radius: 8px !important;
        font-family: 'Roboto', 'Segoe UI', sans-serif;
        font-weight: 800 !important;
        letter-spacing: 2px !important;
        font-size: clamp(11px, 1.25vw, 16px) !important;
        text-transform: uppercase !important;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
        transition: all 0.22s ease !important;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5) !important;
    }

    .btn-back {
        border: 1.5px solid rgba(255, 179, 0, 0.5) !important;
        color: #FFD700 !important;
    }

    .btn-back:hover {
        background: rgba(255, 179, 0, 0.25) !important;
        border-color: #FFD700 !important;
        transform: scale(1.03);
        box-shadow: 0 0 20px rgba(255, 215, 0, 0.7) !important;
    }

    .btn-save {
        border: 1.5px solid rgba(0, 230, 118, 0.6) !important;
        color: #00E676 !important;
    }

    .btn-save:hover {
        background: rgba(0, 230, 118, 0.25) !important;
        border-color: #00E676 !important;
        transform: scale(1.03);
        box-shadow: 0 0 20px rgba(0, 230, 118, 0.7) !important;
    }
</style>

@code {
    private string _selectedLocale = "pt-BR";
    private int _crewCount = 4;
    private int _minBaseCards = 5;
    private bool _liveNasaSync = true;

    private bool IsPortuguese => _selectedLocale.StartsWith("pt", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        _selectedLocale = GameService.CurrentSession.Locale;
        _crewCount = GameService.CurrentSession.CrewCount;
        _minBaseCards = GameService.CurrentSession.MinimumCardsToBuildBase;
        _liveNasaSync = MlModelService.LiveNasaApiSyncEnabled;
    }

    private void SaveOptions()
    {
        GameService.CurrentSession.Locale = _selectedLocale;
        GameService.CurrentSession.CrewCount = _crewCount;
        GameService.CurrentSession.MinimumCardsToBuildBase = _minBaseCards;
        MlModelService.LiveNasaApiSyncEnabled = _liveNasaSync;

        string msg = IsPortuguese
            ? "Configurações aplicadas com sucesso! Telemetria e parâmetros salvos."
            : "Settings applied successfully! Telemetry and parameters saved.";

        Snackbar.Add(msg, Severity.Success, config =>
        {
            config.Icon = Icons.Material.Filled.CheckCircle;
            config.ShowCloseIcon = true;
        });
    }
}
