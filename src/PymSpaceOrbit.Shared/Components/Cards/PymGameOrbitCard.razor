    .pymgameorbit-card-glossary-chip:hover {
        background: rgba(0, 229, 255, 0.45);
        color: #FFFFFF;
        box-shadow: 0 0 8px rgba(0, 229, 255, 0.6);
    }
</style>

@code {
    private const int LongPressThresholdMs = 450;
    private const int TouchHintDisplayDurationMs = 2600;
    private const double TouchMoveCancelThresholdPx = 10.0;

    [Parameter] public GameCardModel? Card { get; set; }
    [Parameter] public bool IsFaceDown { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public string Locale { get; set; } = "en-US";
    [Parameter] public string? CustomStyle { get; set; }
    [Parameter] public string? CustomClass { get; set; }
    [Parameter] public EventCallback<GameCardModel> OnCardClicked { get; set; }
    [Parameter] public EventCallback<TechnicalTermNote> OnTermClicked { get; set; }

    private string _currentPhotoUrl = string.Empty;
    private string? _loadedCardId;
    private bool _photoFailed;
    private bool _triedFallbackVariant;

    private bool _showOriginalNameHint;
    private bool _isPointerDown;
    private bool _longPressTriggered;
    private bool _suppressNextClick;
    private double _pointerDownX;
    private double _pointerDownY;
    private CancellationTokenSource? _longPressCts;
    private CancellationTokenSource? _autoHideCts;

    private bool IsPortuguese => Locale.StartsWith("pt", StringComparison.OrdinalIgnoreCase);

    private string DisplayName => Card is null
        ? string.Empty
        : Card.GetDisplayName(IsPortuguese);

    private string OriginalName => Card is null
        ? string.Empty
        : Card.GetOriginalName(IsPortuguese);

    private string KidSummary => Card is null
        ? string.Empty
        : (IsPortuguese ? (string.IsNullOrWhiteSpace(Card.KidSummaryPtBr) ? Card.KidSummaryEn : Card.KidSummaryPtBr) : Card.KidSummaryEn);

    private string UiLabel => Card is null
        ? string.Empty
        : (IsPortuguese ? (string.IsNullOrWhiteSpace(Card.GameUiLabelPtBr) ? Card.GameUiLabelEn : Card.GameUiLabelPtBr) : Card.GameUiLabelEn);

    protected override async Task OnParametersSetAsync()
    {
        if (Card is null || IsFaceDown)
        {
            _currentPhotoUrl = string.Empty;
            _photoFailed = false;
            CancelPendingTimers();
            _showOriginalNameHint = false;
            return;
        }

        if (_loadedCardId != Card.CardId)
        {
            _loadedCardId = Card.CardId;
            _photoFailed = false;
            _triedFallbackVariant = false;
            _showOriginalNameHint = false;
            CancelPendingTimers();
            _currentPhotoUrl = Card.NasaImageAssetUrl;

            if (!string.IsNullOrWhiteSpace(Card.NasaImageApiUrl))
            {
                var resolved = await ImageResolver.ResolveImageUrlAsync(Card.NasaImageApiUrl, Card.NasaImageAssetUrl);
                if (!string.IsNullOrWhiteSpace(resolved) && resolved != _currentPhotoUrl)
                {
                    _currentPhotoUrl = resolved;
                }
            }
        }
    }

    private void HandlePointerEnter(PointerEventArgs e)
    {
        if (IsFaceDown || Card is null) return;

        if (IsMousePointer(e.PointerType))
        {
            CancelAutoHideTimer();
            _showOriginalNameHint = true;
        }
    }

    private void HandlePointerLeave(PointerEventArgs e)
    {
        if (IsMousePointer(e.PointerType))
        {
            CancelPendingTimers();
            _showOriginalNameHint = false;
        }
        else
        {
            _isPointerDown = false;
            CancelLongPressTimer();
        }
    }

    private void HandlePointerDown(PointerEventArgs e)
    {
        if (IsFaceDown || Card is null) return;

        if (IsMousePointer(e.PointerType))
        {
            return;
        }

        CancelAutoHideTimer();
        _isPointerDown = true;
        _longPressTriggered = false;
        _pointerDownX = e.ClientX;
        _pointerDownY = e.ClientY;

        StartLongPressTimer();
    }

    private void HandlePointerMove(PointerEventArgs e)
    {
        if (!_isPointerDown || _longPressTriggered || IsMousePointer(e.PointerType))
        {
            return;
        }

        double dx = Math.Abs(e.ClientX - _pointerDownX);
        double dy = Math.Abs(e.ClientY - _pointerDownY);
        if (dx > TouchMoveCancelThresholdPx || dy > TouchMoveCancelThresholdPx)
        {
            _isPointerDown = false;
            CancelLongPressTimer();
        }
    }

    private void HandlePointerUp(PointerEventArgs e)
    {
        if (IsMousePointer(e.PointerType))
        {
            return;
        }

        _isPointerDown = false;
        CancelLongPressTimer();

        if (_longPressTriggered)
        {
            StartAutoHideTimer();
        }
    }

    private void HandlePointerCancel(PointerEventArgs e)
    {
        _isPointerDown = false;
        CancelLongPressTimer();
        if (_longPressTriggered)
        {
            _longPressTriggered = false;
            _showOriginalNameHint = false;
        }
    }

    private void HandleContextMenu(MouseEventArgs _)
    {
        // Prevents default browser context menu during touch long-press on cards
    }

    private void DismissHint()
    {
        CancelPendingTimers();
        _longPressTriggered = false;
        _showOriginalNameHint = false;
    }

    private void StartLongPressTimer()
    {
        CancelLongPressTimer();
        var cts = new CancellationTokenSource();
        _longPressCts = cts;
        var token = cts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(LongPressThresholdMs, token);
                if (!token.IsCancellationRequested && _isPointerDown)
                {
                    await InvokeAsync(() =>
                    {
                        if (_isPointerDown && !IsFaceDown && Card is not null)
                        {
                            _longPressTriggered = true;
                            _suppressNextClick = true;
                            _showOriginalNameHint = true;
                            StateHasChanged();
                        }
                    });
                }
            }
            catch (TaskCanceledException)
            {
            }
        }, token);
    }

    private void StartAutoHideTimer()
    {
        CancelAutoHideTimer();
        var cts = new CancellationTokenSource();
        _autoHideCts = cts;
        var token = cts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TouchHintDisplayDurationMs, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        _showOriginalNameHint = false;
                        _longPressTriggered = false;
                        StateHasChanged();
                    });
                }
            }
            catch (TaskCanceledException)
            {
            }
        }, token);
    }

    private void CancelLongPressTimer()
    {
        if (_longPressCts is not null)
        {
            _longPressCts.Cancel();
            _longPressCts.Dispose();
            _longPressCts = null;
        }
    }

    private void CancelAutoHideTimer()
    {
        if (_autoHideCts is not null)
        {
            _autoHideCts.Cancel();
            _autoHideCts.Dispose();
            _autoHideCts = null;
        }
    }

    private void CancelPendingTimers()
    {
        CancelLongPressTimer();
        CancelAutoHideTimer();
    }

    private static bool IsMousePointer(string? pointerType)
    {
        return string.IsNullOrEmpty(pointerType) || pointerType.Equals("mouse", StringComparison.OrdinalIgnoreCase);
    }

    private string GetAccessibleCardLabel()
    {
        if (IsFaceDown || Card is null) return string.Empty;
        return $"{DisplayName} ({OriginalName})";
    }

    private bool IsShipBuildTemplate()
    {
        if (Card is null) return false;
        if (Card.CardId.StartsWith("BLD", StringComparison.OrdinalIgnoreCase)) return true;
        return !Card.CardId.StartsWith("ECL", StringComparison.OrdinalIgnoreCase)
            && !Card.CardId.StartsWith("ENV", StringComparison.OrdinalIgnoreCase)
            && !Card.CardId.StartsWith("ARC", StringComparison.OrdinalIgnoreCase)
            && !Card.CardId.StartsWith("SWX", StringComparison.OrdinalIgnoreCase)
            && (Card.Category is CardSlotCategory.ShipAndBaseHull or CardSlotCategory.PowerAndThermal);
    }

    private void HandleImageError()
    {
        if (!_triedFallbackVariant && !string.IsNullOrWhiteSpace(_currentPhotoUrl))
        {
            _triedFallbackVariant = true;
            if (_currentPhotoUrl.Contains("~medium.jpg", StringComparison.OrdinalIgnoreCase))
            {
                _currentPhotoUrl = _currentPhotoUrl.Replace("~medium.jpg", "~thumb.jpg", StringComparison.OrdinalIgnoreCase);
                return;
            }
            if (_currentPhotoUrl.Contains("~large.jpg", StringComparison.OrdinalIgnoreCase))
            {
                _currentPhotoUrl = _currentPhotoUrl.Replace("~large.jpg", "~thumb.jpg", StringComparison.OrdinalIgnoreCase);
                return;
            }
        }

        _photoFailed = true;
    }

    private string GetCategoryIcon()
    {
        if (Card is null) return Icons.Material.Filled.RocketLaunch;
        string id = Card.CardId;
        if (id.StartsWith("ECL", StringComparison.OrdinalIgnoreCase)) return Icons.Material.Filled.WaterDrop;
        if (id.StartsWith("ENV", StringComparison.OrdinalIgnoreCase)) return Icons.Material.Filled.Public;
        if (id.StartsWith("ARC", StringComparison.OrdinalIgnoreCase)) return Icons.Material.Filled.Architecture;
        if (id.StartsWith("SWX", StringComparison.OrdinalIgnoreCase)) return Icons.Material.Filled.WbTwilight;
        return Icons.Material.Filled.Rocket;
    }

    private string GetCategoryThemeClass()
    {
        if (Card is null) return "theme-bld";
        string id = Card.CardId;
        if (id.StartsWith("ECL", StringComparison.OrdinalIgnoreCase)) return "theme-ecl";
        if (id.StartsWith("ENV", StringComparison.OrdinalIgnoreCase)) return "theme-env";
        if (id.StartsWith("ARC", StringComparison.OrdinalIgnoreCase)) return "theme-arc";
        if (id.StartsWith("SWX", StringComparison.OrdinalIgnoreCase)) return "theme-swx";
        return "theme-bld";
    }

    private string GetTemplateBackground()
    {
        if (IsFaceDown || Card is null)
            return PymGameOrbitAssets.CardBack;

        string id = Card.CardId;
        if (id.StartsWith("BLD", StringComparison.OrdinalIgnoreCase))
            return PymGameOrbitAssets.Deck1ShipBuild;
        if (id.StartsWith("ECL", StringComparison.OrdinalIgnoreCase))
            return PymGameOrbitAssets.Deck2Eclss;
        if (id.StartsWith("ENV", StringComparison.OrdinalIgnoreCase))
            return PymGameOrbitAssets.Deck3Environment;
        if (id.StartsWith("ARC", StringComparison.OrdinalIgnoreCase))
            return PymGameOrbitAssets.Deck4OutpostDecisions;
        if (id.StartsWith("SWX", StringComparison.OrdinalIgnoreCase))
            return PymGameOrbitAssets.Deck5SpaceWeather;

        return Card.Category switch
        {
            CardSlotCategory.ShipAndBaseHull or CardSlotCategory.PowerAndThermal => PymGameOrbitAssets.Deck1ShipBuild,
            CardSlotCategory.MarshallEclssLoop => PymGameOrbitAssets.Deck2Eclss,
            CardSlotCategory.EnvironmentAndSuits => PymGameOrbitAssets.Deck3Environment,
            CardSlotCategory.OutpostArchitecture => PymGameOrbitAssets.Deck4OutpostDecisions,
            CardSlotCategory.DonkiSpaceWeatherCounter => PymGameOrbitAssets.Deck5SpaceWeather,
            _ => PymGameOrbitAssets.Deck1ShipBuild
        };
    }

    private string GetContainerStyle()
    {
        return CustomStyle ?? string.Empty;
    }

    private async Task HandleCardClick()
    {
        if (_suppressNextClick)
        {
            _suppressNextClick = false;
            return;
        }

        if (_longPressTriggered)
        {
            _longPressTriggered = false;
            return;
        }

        if (Card is not null && OnCardClicked.HasDelegate)
        {
            await OnCardClicked.InvokeAsync(Card);
        }
    }

    private async Task HandleTermClick(TechnicalTermNote term)
    {
        if (OnTermClicked.HasDelegate)
        {
            await OnTermClicked.InvokeAsync(term);
        }
    }

    public void Dispose()
    {
        CancelPendingTimers();
    }
}
