    /* Aligned with the 2:3 deck templates central window */
    .pymgameorbit-card-nasa-window {
        position: absolute;
        top: 19.2%;
        left: 13.8%;
        width: 72.4%;
        height: 46.2%;
        overflow: hidden;
        z-index: 2;
        border-radius: 3px;
        background-color: #040812;
        display: flex;
