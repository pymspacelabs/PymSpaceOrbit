@namespace PymSpaceOrbit.Shared.Components.Cards
@inject ILocalizer<PymGameOrbitCard> L
@using System.Threading
@using Microsoft.AspNetCore.Components.Web
@using PymSpaceOrbit.Shared.Models.Game
@using PymSpaceOrbit.Shared.Services
@implements IDisposable
@inject NasaCardImageResolver ImageResolver

<div class="pymgameorbit-card-container @(IsSelected ? "pymgameorbit-card-selected" : "") @CustomClass"
     style="@GetContainerStyle()"
     aria-label="@GetAccessibleCardLabel()"
     @onpointerenter="HandlePointerEnter"
     @onpointerleave="HandlePointerLeave"
     @onpointerdown="HandlePointerDown"
     @onpointermove="HandlePointerMove"
     @onpointerup="HandlePointerUp"
     @onpointercancel="HandlePointerCancel"
     @oncontextmenu="HandleContextMenu"
     @oncontextmenu:preventDefault="true"
     @onclick="HandleCardClick"
     @onclick:stopPropagation="true">

    <!-- Background Template / Back Layer -->
    <img src="@GetTemplateBackground()"
         alt=""
         class="pymgameorbit-card-template-img" />

    @if (!IsFaceDown && Card is not null)
    {
        <!-- Central 90° Rectangular Window for NASA Official Photo -->
        <div class="pymgameorbit-card-nasa-window">
            @if (!_photoFailed && !string.IsNullOrWhiteSpace(_currentPhotoUrl))
            {
                <img src="@_currentPhotoUrl"
                     alt=""
                     class="pymgameorbit-card-photo"
                     loading="lazy"
                     referrerpolicy="no-referrer"
                     @onerror="HandleImageError" />
            }
            else
            {
                <!-- Holographic NASA Telemetry Fallback (Never displays broken alt text) -->
                <div class="pymgameorbit-card-photo-placeholder @GetCategoryThemeClass()">
                    <MudIcon Icon="@GetCategoryIcon()" Size="Size.Medium" Class="hologram-icon" />
                    <span class="hologram-badge">@Card.CardId</span>
                    <span class="hologram-sub">NASA TELEMETRY</span>
                </div>
            }
        </div>

        <!-- Top Banner: Short Child-Friendly Display Name -->
        <div class="pymgameorbit-card-top-banner @(IsShipBuildTemplate() ? "banner-bld" : "")">
            <span class="pymgameorbit-card-title">@DisplayName</span>
        </div>

        <!-- Cross-Platform Original-Name Hint (Hover on Mouse/Desktop, Long-Press on Touch/Mobile) -->
        <MudPopover Open="@_showOriginalNameHint"
                    AnchorOrigin="Origin.TopCenter"
                    TransformOrigin="Origin.BottomCenter"
                    OverflowBehavior="OverflowBehavior.FlipAlways"
                    Paper="false"
                    Class="pymgameorbit-original-name-popover">
            <div class="pymgameorbit-original-name-hint" @onclick="DismissHint">
                <span class="pymgameorbit-hint-badge">
                        @L["OriginalScientificName"]
                </span>
                <span class="pymgameorbit-hint-title">@OriginalName</span>
            </div>
        </MudPopover>

        <!-- Bottom Panel: Costs, Trade-Offs & Technical Glossary Chips -->
        <div class="pymgameorbit-card-bottom-panel">
            <div class="pymgameorbit-card-attributes-text" title="@UiLabel">
                @UiLabel
            </div>

            @if (Card.TechnicalGlossary is not null && Card.TechnicalGlossary.Count > 0)
            {
                <div class="pymgameorbit-card-chips-row">
                    @foreach (var term in Card.TechnicalGlossary.Values.Take(3))
                    {
                        <span class="pymgameorbit-card-glossary-chip"
                              @onpointerdown:stopPropagation="true"
                              @onclick:stopPropagation="true"
                              @onclick="@(() => HandleTermClick(term))"
                              title="@(IsPortuguese ? term.ExplanationPtBr : term.ExplanationEn)">
                            @term.Term
                        </span>
                    }
                </div>
            }
        </div>
    }
</div>

<style>
