@namespace PymSpaceOrbit.Shared.Components.Cards
@using PymSpaceOrbit.Shared.Models.Game

@* Legacy compatibility wrapper: delegates to PymGameOrbitCard *@
<PymGameOrbitCard Card="@Card"
                  IsFaceDown="@IsFaceDown"
                  IsSelected="@IsSelected"
                  Locale="@Locale"
                  CustomStyle="@CustomStyle"
                  CustomClass="@CustomClass"
                  OnCardClicked="@OnCardClicked"
                  OnTermClicked="@OnTermClicked" />

@code {
    [Parameter] public GameCardModel? Card { get; set; }
    [Parameter] public bool IsFaceDown { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public string Locale { get; set; } = "pt-BR";
    [Parameter] public string? CustomStyle { get; set; }
    [Parameter] public string? CustomClass { get; set; }
    [Parameter] public EventCallback<GameCardModel> OnCardClicked { get; set; }
    [Parameter] public EventCallback<TechnicalTermNote> OnTermClicked { get; set; }
}
