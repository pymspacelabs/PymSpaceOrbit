@inherits LayoutComponentBase
@implements IDisposable
@namespace PymSpaceOrbit.Shared.Layout
@using MudBlazor
@using Microsoft.AspNetCore.Components.Routing
@using PymSpaceOrbit.Shared.Abstractions.Game
@using PymSpaceOrbit.Shared.Models.Game
@inject IGameService GameService
@inject IAudioService AudioService
@inject NavigationManager Navigation

<MudThemeProvider Theme="_spaceTheme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Medium" CloseButton="true" />
<MudSnackbarProvider />

<MudLayout Class="pym-space-root">
    <MudAppBar Elevation="1" Dense="true" Class="pym-space-appbar">
        <MudTooltip Text="PymGameOrbit">
            <MudIconButton Icon="@Icons.Material.Filled.RocketLaunch" Color="Color.Primary" Edge="Edge.Start" Href="/" />
        </MudTooltip>
        <MudText Typo="Typo.h6" Class="ml-2 font-weight-bold" Style="color: #00E5FF; letter-spacing: 1.5px; font-size: 14px;">
            PYMGAMEORBIT
        </MudText>

        <MudSpacer />

        <MudButton Variant="Variant.Text" Href="/" StartIcon="@Icons.Material.Filled.Home" Color="Color.Inherit" Size="Size.Small" Class="mx-1 appbar-nav-btn">
            @(IsPortuguese ? "Início" : "Home")
        </MudButton>

        <MudButton Variant="Variant.Text" OnClick="OpenPlayCampaignDialog" StartIcon="@Icons.Material.Filled.SportsEsports" Color="Color.Inherit" Size="Size.Small" Class="mx-1 appbar-nav-btn">
            @(IsPortuguese ? "Jogar" : "Play")
        </MudButton>

        <MudButton Variant="Variant.Text" Href="/info" StartIcon="@Icons.Material.Filled.CollectionsBookmark" Color="Color.Inherit" Size="Size.Small" Class="mx-1 appbar-nav-btn">
            @(IsPortuguese ? "Card Sets" : "Cards")
        </MudButton>

        <MudButton Variant="Variant.Text" Href="/options" StartIcon="@Icons.Material.Filled.Tune" Color="Color.Inherit" Size="Size.Small" Class="mx-1 appbar-nav-btn">
            @(IsPortuguese ? "Opções" : "Options")
        </MudButton>

        <MudDivider Vertical="true" FlexItem="true" Class="my-2 mx-2" Style="border-color: rgba(0, 229, 255, 0.3);" />

        <!-- Locale Toggle -->
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ToggleLocale"
                   Style="color: #FFD700; border-color: rgba(255, 215, 0, 0.5); font-weight: bold; min-width: 65px; height: 28px; padding: 0 8px;">
            @(IsPortuguese ? "🇧🇷 PT" : "🇺🇸 EN")
        </MudButton>

        <!-- Dark/Light Theme Toggle -->
        <MudTooltip Text="@(_isDarkMode ? "Tema Claro / Light" : "Tema Escuro / Dark")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Warning"
                           Size="Size.Small"
                           OnClick="ToggleTheme"
                           Class="ml-1" />
        </MudTooltip>
    </MudAppBar>

    <MudMainContent Class="pym-space-main-content">
        @Body
    </MudMainContent>
</MudLayout>

<!-- Modal Compartilhada de Início de Missão / New Campaign Dialog (Top Bar PLAY) -->
<MudDialog @bind-Visible="_showTopPlayModal" Options="_topPlayDialogOptions">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6" Style="color: #00E5FF; font-weight: bold;">
                @(IsPortuguese ? "CONFIGURAR NOVA EXPEDIÇÃO" : "NEW MISSION CAMPAIGN SETUP")
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-3" Style="color: #8B949E;">
            @(IsPortuguese ? "Selecione o destino da sua nave PymGameOrbit, tamanho da tripulação e regras de construção:"
                           : "Select your PymGameOrbit mission destination, astronaut crew size and base building rules:")
        </MudText>

        <MudText Typo="Typo.body2" Class="font-weight-bold mb-1" Style="color: #FFD700;">
            @(IsPortuguese ? "Destino da Missão:" : "Mission Destination:")
        </MudText>
        <MudRadioGroup @bind-Value="_selectedDestination" T="OutpostDestination" Class="d-flex flex-wrap justify-space-between mb-4">
            <MudRadio Value="OutpostDestination.ISS" Color="Color.Primary" Dense="true">
                <span style="font-weight: 600;">🛰️ ISS</span>
                <span style="font-size: 11px; color: #8B949E; display: block;">(LEO 414 km / 8 @(IsPortuguese ? "turnos" : "turns"))</span>
            </MudRadio>
            <MudRadio Value="OutpostDestination.Moon" Color="Color.Secondary" Dense="true">
                <span style="font-weight: 600;">🌕 @(IsPortuguese ? "Lua (Moon)" : "Moon")</span>
                <span style="font-size: 11px; color: #8B949E; display: block;">(Artemis Gateway / 10 @(IsPortuguese ? "turnos" : "turns"))</span>
            </MudRadio>
            <MudRadio Value="OutpostDestination.Mars" Color="Color.Error" Dense="true">
                <span style="font-weight: 600;">🔴 @(IsPortuguese ? "Marte (Mars)" : "Mars")</span>
                <span style="font-size: 11px; color: #8B949E; display: block;">(ISRU Surface / 12 @(IsPortuguese ? "turnos" : "turns"))</span>
            </MudRadio>
        </MudRadioGroup>

        <div class="mb-4">
            <div class="d-flex justify-space-between align-center mb-1">
                <MudText Typo="Typo.body2" Style="color: #00E676; font-weight: 600;">
                    @(IsPortuguese ? "Tamanho da Tripulação:" : "Astronaut Crew Count:")
                </MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined">
                    @_crewCount @(IsPortuguese ? "astronautas" : "astronauts")
                </MudChip>
            </div>
            <MudSlider T="int" Min="1" Max="16" @bind-Value="_crewCount" Color="Color.Tertiary" ValueLabel="true" />
        </div>

        <div class="mb-2">
            <div class="d-flex justify-space-between align-center mb-1">
                <MudText Typo="Typo.body2" Style="color: #00E5FF; font-weight: 600;">
                    @(IsPortuguese ? "Mínimo de Cartas para a Base:" : "Min. Base Build Cards:")
                </MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                    @_minCards @(IsPortuguese ? "cartas" : "cards")
                </MudChip>
            </div>
            <MudSlider T="int" Min="3" Max="8" @bind-Value="_minCards" Color="Color.Primary" ValueLabel="true" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseTopPlayDialog" Color="Color.Default" Variant="Variant.Text">
            @(IsPortuguese ? "Cancelar" : "Cancel")
        </MudButton>
        <MudButton OnClick="LaunchCampaignFromTopBar"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Launch"
                   Style="font-weight: bold; background: linear-gradient(90deg, #00E5FF, #0097A7); color: #000;">
            @(IsPortuguese ? "INICIAR MISSÃO" : "LAUNCH MISSION")
        </MudButton>
    </DialogActions>
</MudDialog>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .pym-space-root {
        background-color: #060911;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .pym-space-appbar {
        background: rgba(10, 14, 26, 0.94) !important;
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(0, 229, 255, 0.3);
        z-index: 100;
    }

    .pym-space-main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding-top: 48px !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        padding-bottom: 0 !important;
        background: #060911;
        overflow-x: hidden;
    }

    @@media (max-width: 768px) {
        .appbar-nav-btn {
            display: none !important;
        }
    }
</style>

@code {
    private bool _isDarkMode = true;
    private bool _showTopPlayModal = false;
    private OutpostDestination _selectedDestination = OutpostDestination.Moon;
    private int _crewCount = 4;
    private int _minCards = 5;

    private readonly DialogOptions _topPlayDialogOptions = new()
    {
        CloseOnEscapeKey = true,
        BackdropClick = true,
        MaxWidth = MaxWidth.Small
    };

    private bool IsPortuguese => GameService.CurrentSession.Locale.StartsWith("pt", StringComparison.OrdinalIgnoreCase);

    private readonly MudTheme _spaceTheme = new()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#00E5FF",           // Electric Cyan
            Secondary = "#FFD700",         // Orbit Gold
            Tertiary = "#00E676",          // Bio Emerald
            Background = "#060911",        // Deep Space Obsidian
            Surface = "#0E1424",           // Space Navy
            AppbarBackground = "#0A0E1A",
            DrawerBackground = "#060911",
            TextPrimary = "#F0F6FC",
            TextSecondary = "#8B949E",
            ActionDefault = "#00E5FF",
            LinesDefault = "rgba(0, 229, 255, 0.2)",
            TableLines = "rgba(0, 229, 255, 0.15)",
            Success = "#00E676",
            Warning = "#FFB300",
            Error = "#FF5252",
            Info = "#00B0FF"
        },
        PaletteLight = new PaletteLight()
        {
            Primary = "#0097A7",
            Secondary = "#FFA000",
            Tertiary = "#2E7D32",
            Background = "#F0F4F8",
            Surface = "#FFFFFF",
            AppbarBackground = "#1A233A",
            TextPrimary = "#1E293B",
            TextSecondary = "#475569"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Roboto", "Segoe UI", "sans-serif" }
            }
        }
    };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AudioService.InitializeAsync();
            await AudioService.SyncScreenMusicAsync(Navigation.Uri, GameService.CurrentSession);
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await AudioService.SyncScreenMusicAsync(e.Location, GameService.CurrentSession);
        });
    }

    private async Task OpenPlayCampaignDialog()
    {
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        _selectedDestination = GameService.CurrentSession.Destination;
        _crewCount = GameService.CurrentSession.CrewCount;
        _minCards = GameService.CurrentSession.MinimumCardsToBuildBase;
        _showTopPlayModal = true;
    }

    private async Task CloseTopPlayDialog()
    {
        _showTopPlayModal = false;
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
    }

    private async Task LaunchCampaignFromTopBar()
    {
        _showTopPlayModal = false;
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        await GameService.StartNewCampaignAsync(
            _selectedDestination,
            _crewCount,
            _minCards,
            GameService.CurrentSession.Locale);
        Navigation.NavigateTo("/play");
        await AudioService.SyncGameplayMusicAsync(GameService.CurrentSession);
    }

    private async Task ToggleLocale()
    {
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        GameService.CurrentSession.Locale = IsPortuguese ? "en-US" : "pt-BR";
    }

    private async Task ToggleTheme()
    {
        await AudioService.PlaySoundEffectAsync(SoundEffect.UiButtonTap);
        _isDarkMode = !_isDarkMode;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
